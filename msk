#!/bin/sh
SOURCE=$0
while [ -h "$SOURCE" ]; do
    DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$DIR/$SOURCE" ;;
    esac
done
DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)"
# Prefer the checkout's virtualenv when present, so msk works from any shell.
if [ -x "$DIR/.venv/bin/python3" ]; then
    PYTHON="$DIR/.venv/bin/python3"
else
    PYTHON="python3"
fi
PYTHONPATH="$DIR/src${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON" -m mobile_skill "$@"
